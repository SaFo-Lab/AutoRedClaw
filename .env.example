# API keys only. Models and providers are always passed on the command line
# (--model/--model-provider, --gen-model/--gen-model-provider, ...); nothing
# here selects a model or provider.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# AWS Bedrock credentials (used with --model-provider bedrock).
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Docker volumes holding the native Codex / Claude Code logins
# (used with --model-provider codex / claudecode); created by initialize.
CODEX_AUTH_VOLUME=redclaw-codex-auth
CLAUDE_CODE_AUTH_VOLUME=redclaw-claudecode-auth
